NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Service role key — server-only, never exposed to the client. Used only for
# seeding/admin scripts that must bypass RLS (e.g. initial org/admin bootstrap).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Used ONLY by Prisma (schema/migrations tool, not a runtime dependency of
# the app). `prisma migrate deploy` works fine over this pooled connection.
# Supabase's DIRECT connection (db.<ref>.supabase.co) is IPv6-only on most
# projects — if your network has no IPv6 route (common on many ISPs), that
# host is simply unreachable and you must use the Session Pooler instead.
# Find both under Supabase Dashboard -> Project Settings -> Database ->
# Connection string; note the username changes to `postgres.<project-ref>`
# for the pooler.
DATABASE_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Direct (non-pooled) connection — only needed if `prisma migrate dev`'s
# shadow-database step requires it AND your network has IPv6 access to it.
# Not required for `prisma migrate deploy`, which is what this project uses.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres"
